# Copia este archivo como ".env" (en la carpeta server/) y coloca tus credenciales reales.
# NUNCA subas el archivo ".env" a un repositorio público ni lo compartas por chat.

# Access Token del panel de MercadoPago: selecciona explícitamente Prueba o Producción.
# El prefijo no basta para determinar el modo; no confundas el token con el usuario de prueba.
MP_ACCESS_TOKEN=TEST-000000000000000-000000-00000000000000000000000000000000-000000000

# Checkout de MercadoPago pausado. Cámbialo a true solo cuando decidas reactivarlo.
MERCADOPAGO_CHECKOUT_ENABLED=false

# WhatsApp comercial en formato internacional, solo dígitos.
WHATSAPP_BUSINESS_NUMBER=51918544859

# Puerto en el que corre el servidor local.
PORT=3000

# URL pública base del sitio (debe ser https en producción para que auto_return y los webhooks funcionen).
BASE_URL=http://localhost:3000

# --- Base de datos SQL Server ---
# Nombre de instancia (ej. "localhost\SQL2023" o "NOMBRE-PC\SQL2023").
DB_SERVER=localhost\SQL2023

# Nombre de la base de datos que usará DigitalRO.
DB_NAME=DigitalRO

# Credenciales de autenticación SQL Server (modo mixto), NO de tu cuenta de Windows.
DB_USER=
DB_PASSWORD=

# Pon en "true" solo si tu instancia exige conexión cifrada (normalmente no en localhost).
DB_ENCRYPT=false

# Clave privada para consultar GET /api/orders (envíala como encabezado x-admin-key).
# Genera una clave aleatoria larga; no uses ni compartas esta plantilla como valor real.
ADMIN_API_KEY=

